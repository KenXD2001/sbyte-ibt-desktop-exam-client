# ─── SBYTE IBT Desktop Exam Client env ─────────────────────────────────
# Copy to .env and fill per deployment. The desktop app talks to the SAME
# exam-server REST API and mediasoup SFU as the candidate portal.

# API (required — app throws if missing)
VITE_API_BASE_URL="http://localhost:5051/api"

# SFU (required — proctoring publish/subscribe fails loudly if missing)
VITE_SFU_URL=http://localhost:5052

# Exam lifecycle WebSocket (NOT media — stays on exam-server).
# Leave blank to derive from VITE_API_BASE_URL (same host, ws(s)://).
VITE_WS_URL=
VITE_WS_HEARTBEAT_INTERVAL=12000
VITE_WS_RECONNECT_BASE_DELAY=1000
VITE_WS_RECONNECT_MAX_DELAY=30000
VITE_WS_RECONNECT_MAX_ATTEMPTS=50

# Publisher capture targets (720p @30 for camera + screen)
VITE_CAM_WIDTH=1280
VITE_CAM_HEIGHT=720
VITE_CAM_FPS=30
VITE_SCREEN_WIDTH=1280
VITE_SCREEN_HEIGHT=720
VITE_SCREEN_FPS=30

# Simulcast bitrates (bps). LOW row = 720p base layer (focus/recording),
# HIGH row = 360p premium layer (grid tiles).
VITE_CAM_LOW_BITRATE=1200000
VITE_CAM_HIGH_BITRATE=300000
VITE_SCREEN_LOW_BITRATE=1200000
VITE_SCREEN_HIGH_BITRATE=300000
VITE_AUDIO_BITRATE=64000
